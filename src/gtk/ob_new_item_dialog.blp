using Gtk 4.0;
using Adw 1;

template $ObNewItemDialog: Adw.PreferencesDialog {
  presentation-mode: floating;
  title: "Add a new Connection";

  Adw.PreferencesPage ssh_settings_page {
    icon-name: "network-transmit-receive-symbolic";
    name: "ssh";
    title: "SSH";

    Adw.PreferencesGroup {
      margin-start: 0;
      margin-top: 0;
      separate-rows: false;
      title: "Connection Settings";

      Adw.EntryRow connection_name_input {
        title: "Connection Name";
      }

      Adw.EntryRow hostname_input {
        title: "Hostname";
      }

      Adw.SpinRow port_input {
        adjustment: Adjustment {
          lower: 1;
          page-increment: 10;
          step-increment: 1;
          upper: 65535;
          value: 22;
        };

        numeric: true;
        title: _("Port");
      }

      Adw.SwitchRow is_jumphost {
        subtitle: "Can be used as jumphost by other connections";
        title: "Jumphost";
      }

      Adw.ComboRow use_jumphost {
        subtitle: "Select a jumphost";
        title: "Use a jumphost";
      }
    }

    Adw.PreferencesGroup {
      title: "Authentication";

      Adw.SwitchRow use_parent_auth {
        subtitle: "From parent folder";
        title: "Inherit Auth Settings";
      }

      Adw.ComboRow auth_method {
        halign: baseline;
        height-request: -1;
        hexpand: false;
        hexpand-set: false;
        model: auth_menu;
        subtitle: "How to Authenticate";
        title: "Authentication";
        valign: fill;
      }

      Adw.EntryRow username_input {
        title: "Username";
      }

      Adw.PasswordEntryRow password_input {
        title: "Password";
      }

      Adw.EntryRow priv_key_input {
        title: "Private Key Path";
      }
    }

    Adw.PreferencesGroup {
      Box {
        halign: fill;

        Button cancel_button {
          css-classes: [
            "destructive-action",
          ];

          halign: start;
          height-request: -1;
          hexpand: true;
          label: "Cancel";
        }

        Button confirm_button {
          halign: end;
          height-request: -1;
          hexpand: false;
          label: "Confirm";
        }
      }
    }
  }
}

StringList auth_menu {
  strings [
    "Keyboard Interactive",
    "Password",
    "Public Key",
  ]
}
